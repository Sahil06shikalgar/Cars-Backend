# Copy this file to `.env` and fill in the values.
# NEVER commit your real `.env` file — it contains secrets.

# MongoDB Atlas connection string.
# Create a cluster at https://cloud.mongodb.com then get the connection URI:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
#
# If your network/VPN refuses DNS SRV lookups, the server gets:
#   querySrv ECONNREFUSED _mongodb._tcp.<cluster>.mongodb.net
# Fix: paste the direct (non-SRV) connection string from Atlas instead, which the
# driver connects to without any SRV lookup, e.g.:
#   mongodb://<user>:<password>@cluster0-shard-00-00.xxxx.mongodb.net:27017,cluster0-shard-00-01.xxxx.mongodb.net:27017,cluster0-shard-00-02.xxxx.mongodb.net:27017/<database>?ssl=true&replicaSet=atlas-xxxxx&retryWrites=true&authSource=admin
MONGODB_URI=

# OPTIONAL — only relevant when MONGODB_URI starts with mongodb+srv:// and the
# DNS SRV lookup is blocked. List the cluster shard addresses (host:port, comma
# separated, the three `cluster0-shard-00-0N` hosts with :27017 from Atlas). The
# server then retries the SRV string as a direct connection. Leave empty to skip.
MONGO_DIRECT_HOSTS=

# Port the API + socket server listens on.
PORT=5050

# Allowed frontend origin for CORS (no trailing slash).
CLIENT_ORIGIN=http://localhost:5173

# Secret used to sign session cookies. Use a long random string.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Cookie flags. Keep SECURE_COOKIES=false while testing over plain http://localhost.
SECURE_COOKIES=false

# Base URL of this API, used to build absolute upload URLs.
API_BASE_URL=http://localhost:5050

# Where uploaded photos are stored on disk (relative to this folder).
UPLOAD_DIR=uploads

# Env is development / production / test
NODE_ENV=development

# Google OAuth — "Sign up / continue with Google".
# Leave GOOGLE_CLIENT_ID + GOOGLE_CLIENT_SECRET empty to keep social sign-up disabled.
#
# 1. Go to https://console.cloud.google.com/apis/credentials → Create OAuth client ID
#    (Application type: Web application).
# 2. Under "Authorized redirect URIs" register the value of GOOGLE_REDIRECT_URI below.
# 3. Paste the client ID and secret into the two variables.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match a registered "Authorized redirect URI" in the Google console.
# In local dev the frontend is served by Vite, which proxies /api — so the browser
# addresses the callback on the frontend origin and Vite forwards it to this API.
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback