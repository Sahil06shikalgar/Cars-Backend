# Production environment template (Render / any Node host).
# Copy the needed values into the platform's env dashboard — do NOT commit real secrets.
# Everything here is optional except MONGODB_URI and SESSION_SECRET.

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
SESSION_SECRET=replace-with-a-long-random-string

NODE_ENV=production
PORT=5050
SECURE_COOKIES=true

# Frontend URL exactly as served by Vercel (no trailing slash).
CLIENT_ORIGIN=https://<your-project>.vercel.app
# This API's own public URL.
API_BASE_URL=https://diecet-backend.onrender.com

UPLOAD_DIR=uploads

# Optional — only if Atlas SRV DNS is blocked on the hosting network.
MONGO_DIRECT_HOSTS=

# Optional Google OAuth. Register GOOGLE_REDIRECT_URI in the Google console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://<your-project>.vercel.app/api/auth/google/callback